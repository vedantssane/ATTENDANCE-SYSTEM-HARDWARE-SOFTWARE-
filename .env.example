# Copy to .env for production database and admin auth configuration.
DATABASE_URL=postgresql://...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key-only
ADMIN_EMAIL=admin@example.com

# Required in deployed environments; replace the local development password.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional accidental-repeat guard for RFID readers (milliseconds).
SCAN_COOLDOWN_MS=2500
